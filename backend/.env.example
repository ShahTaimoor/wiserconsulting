# Variables introduced by the Tourist Visa feature. The other variables the
# backend uses (MONGODB_URI, JWT_SECRET, ...) live in your private .env.
# Never commit a real value.

# Server-side switch for the whole Tourist Visa API. The API is open ONLY when this is
# exactly the text: true
# Unset, empty, "false" or anything else keeps it closed: every request under
# /api/tourist-visa then gets a fixed 404 {"code":"FEATURE_CLOSED"} before any sign-in check,
# body parsing or database access, and nothing is logged about the request.
# Production default: leave it unset. Local and test deployments: true.
# The client has its own gate (NEXT_PUBLIC_TOURIST_VISA_PREVIEW and the open "tbc" items);
# production needs the two to agree. See docs/tourist-visa-handover.md.
#
# SAFE START (step 8j-3): while this is exactly "true" the server REFUSES TO START (it exits with a message that names the
# variable, never its value) unless FIELD_ENCRYPTION_KEY is set and valid, JWT_SECRET is set, and, when AI_ENABLED is
# "true", AI_PROVIDER is groq and GROQ_API_KEY is set. While the switch is off none of this is checked.
TOURIST_VISA_ENABLED=

# NODE_ENV: set it to exactly "development" on your own machine (or "test" in the tests). ANY other value, including unset,
# "prod" or "Production", counts as production for the AI data-terms guard (see AI_DATA_TERMS_CONFIRMED below), so a
# forgotten or misspelled value can never switch that guard off. On the live server set it to "production".
# (Commented out so that copying this file never sets it to an empty text, which would count as production.)
# NODE_ENV=development

# Key used to encrypt sensitive Tourist Visa answers at rest (passport and ID
# numbers, security-history answers). 32 random bytes as base64 or hex.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes the encrypted answers unreadable, so keep a secure
# backup, and set the same value everywhere the backend runs (including Vercel).
# Only needed when TOURIST_VISA_ENABLED=true.
FIELD_ENCRYPTION_KEY=

# File storage: Cloudflare R2 (replaces Cloudinary). Needed by the whole backend (assessment uploads, logo, testimonials,
# approved visas) and by the Tourist Visa documents. If one is missing the server names it in the log at startup (never a
# value) and uploads fail.
#   R2_ACCOUNT_ID         Cloudflare dashboard > R2 > Overview (Account ID)
#   R2_ACCESS_KEY_ID /
#   R2_SECRET_ACCESS_KEY  R2 > Manage API tokens > Create token (Object Read & Write, for the two buckets below)
#   R2_PRIVATE_BUCKET     bucket for passports, bank statements and Tourist Visa documents. NO public access, NO custom domain.
#   R2_PUBLIC_BUCKET      bucket for the logo, testimonial photos and approved-visa photos. Public.
#   R2_PUBLIC_BASE_URL    the public address of the public bucket, no trailing slash, e.g. https://cdn.wiserconsulting.info
#                         (a custom domain connected to the bucket, or its r2.dev URL).
# The same bucket CORS rule is needed on the private bucket for the admin screen's Download button (see docs).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=

# AI-assisted cover letter for the Tourist Visa admin (admin only; a template letter is always the fallback, and
# submitting an application never depends on the AI). The AI is OFF unless AI_ENABLED is exactly "true".
# It sends real trip, employment and money details (never names, contact details or identifiers) to the provider.
AI_ENABLED=
# "groq" is the only provider built.
AI_PROVIDER=
GROQ_API_KEY=
# Optional. Leave empty to use the default model set in config/ai.js.
GROQ_MODEL=
# Optional. AI letters per day in total (UTC day), default 200.
AI_DAILY_LIMIT=
# Optional. AI letters one administrator can ask for per hour, default 15.
AI_ADMIN_HOURLY_LIMIT=
# REQUIRED in production, exactly "true": someone has confirmed that Zero Data Retention is switched on for the Groq
# account and has read Groq's terms about training on customer data. Without it the AI is not used in production
# ("production" is anything but NODE_ENV exactly "development" or "test"); the server still starts and says so in the log.
AI_DATA_TERMS_CONFIRMED=
