# Variables introduced by the Tourist Visa feature. The other variables the
# backend uses (MONGODB_URI, JWT_SECRET, ...) live in your private .env.
# Never commit a real value.

# Server-side switch for the whole Tourist Visa API. The API is open ONLY when this is
# exactly the text: true
# Unset, empty, "false" or anything else keeps it closed: every request under
# /api/tourist-visa then gets a fixed 404 {"code":"FEATURE_CLOSED"} before any sign-in check,
# body parsing or database access, and nothing is logged about the request.
# Production default: leave it unset. Local and test deployments: true.
# The client has its own gate (NEXT_PUBLIC_TOURIST_VISA_PREVIEW and the open "tbc" items);
# production needs the two to agree. See docs/tourist-visa-handover.md.
TOURIST_VISA_ENABLED=

# Key used to encrypt sensitive Tourist Visa answers at rest (passport and ID
# numbers, security-history answers). 32 random bytes as base64 or hex.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes the encrypted answers unreadable, so keep a secure
# backup, and set the same value everywhere the backend runs (including Vercel).
# Only needed when TOURIST_VISA_ENABLED=true.
FIELD_ENCRYPTION_KEY=

# Private file storage for the uploaded passport and funds documents. These are the SAME three
# variables the rest of the backend already reads for Cloudinary (config/cloudinary.js), so a
# deployment that has the assessment uploads already has them. Only needed when
# TOURIST_VISA_ENABLED=true; if one is missing the server names it in the log at startup (never a
# value) and every upload answers 503 STORAGE_UNAVAILABLE.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
